#: includes/settings-fields.php:884
msgid "Stands in the middle of the space between the slides and moves with them."
msgstr ""

#: includes/settings-fields.php:889
msgid "Separator image"
msgstr ""

#: includes/settings-fields.php:892
msgid "From the media library; PNG or SVG with a transparent background suits best."
msgstr ""

#: includes/settings-fields.php:897
msgid "Separator size (px)"
msgstr ""

#: includes/settings-fields.php:904
msgid "The dot's diameter; an image fits in a square of this size. The space between the slides is at least as wide."
msgstr ""

#: includes/settings-fields.php:909
msgid "Dot color"
msgstr ""

#: includes/settings-fields.php:915
msgid "Image fit"
msgstr ""

#: includes/settings-fields.php:922
msgid "Cover: the image fills the slide, cropped where its proportions differ. Contain: the whole image is shown, with empty space beside it where its proportions differ."
msgstr ""

#: includes/settings-fields.php:928
msgid "Make the active slide wider"
msgstr ""

#: includes/settings-fields.php:931
msgid "The number of slides comes from “Slides per view”, always rounded to a whole number."
msgstr ""

#: includes/settings-fields.php:936
msgid "Active slide size (%)"
msgstr ""

#: includes/settings-fields.php:943
msgid "% of the slider width (vertical sliders: of its height)."
msgstr ""

#: includes/settings-fields.php:957
#: includes/settings-fields.php:975
#: includes/settings-fields.php:1034
msgid "Top"
msgstr ""

#: includes/settings-fields.php:962
#: includes/settings-fields.php:977
#: includes/settings-fields.php:1039
msgid "Bottom"
msgstr ""

#: includes/settings-fields.php:965
msgid "The part of the image kept in view where it is cropped to fill its slide. Not for YouTube / Vimeo videos."
msgstr ""

#: includes/settings-fields.php:971
#: includes/settings-fields.php:982
msgid "Image alignment"
msgstr ""

#: includes/settings-fields.php:996
msgid "Zoom the main image"
msgstr ""

#: includes/settings-fields.php:999
msgid "The image of the slide in view slowly zooms in or out while it is shown. Slide effect: with one slide in view (Slides per view 1 on every device) or the wider active slide. Not for video slides."
msgstr ""

#: includes/settings-fields.php:1004
msgid "Zoom direction"
msgstr ""

#: includes/settings-fields.php:1009
msgid "Zoom in"
msgstr ""

#: includes/settings-fields.php:1010
msgid "Zoom out"
msgstr ""

#: includes/settings-fields.php:1016
msgid "Zoom (%)"
msgstr ""

#: includes/settings-fields.php:1023
msgid "How much larger the image gets: 15 = 115% of its size."
msgstr ""

#: includes/settings-fields.php:1028
msgid "Zoom towards"
msgstr ""

#: includes/settings-fields.php:1042
msgid "The point of the image that stays in place: the rest grows away from it (zoom in) or towards it (zoom out)."
msgstr ""

#: includes/settings-fields.php:1048
msgid "Zoom duration (ms)"
msgstr ""

#: includes/settings-fields.php:1056
msgid "Auto (empty): as long as a slide is shown with Autoplay (its delay plus the transition speed); without Autoplay, 6000."
msgstr ""

#: includes/settings-fields.php:1068
msgid "0 = 500px. Auto: fills the free height of the parent column; where there is none, follows the first image’s proportions."
msgstr ""

#: includes/settings-fields.php:1070
msgid "0 = 500px. Auto: fills the free height of the parent column. If the height is greater than that of the images that fit in a row, it is ignored: the slider is as tall as the tallest of them."
msgstr ""

#: includes/settings-fields.php:1077
msgid "Image proportions"
msgstr ""

#: includes/settings-fields.php:1082
msgid "Off"
msgstr ""

#: includes/settings-fields.php:1092
msgid "Every image is as tall as the Height and as wide as these proportions make it; Slides per view of them share the row and the free width goes around them (Distribution). Space between slides is the least space left; where they do not fit with it, they get smaller. Off: the images fill the row."
msgstr ""

#: includes/settings-fields.php:1098
#: includes/settings-fields.php:1447
msgid "Custom proportions"
msgstr ""

#: includes/settings-fields.php:1103
#: includes/settings-fields.php:1452
msgid "Width x height, for example 4x3 or 2.35x1."
msgstr ""

#: includes/settings-fields.php:1109
msgid "Distribution"
msgstr ""

#: includes/settings-fields.php:1114
msgid "Space between"
msgstr ""

#: includes/settings-fields.php:1115
msgid "Space around"
msgstr ""

#: includes/settings-fields.php:1117
msgid "Space between: the outer images at the row's edges, the free width between them. Space around: each image in the middle of its equal share, so half a space at the edges."
msgstr ""

#: includes/settings-fields.php:1140
msgid "Visible neighbours"
msgstr ""

#: includes/settings-fields.php:1146
msgid "Slides in view on each side of the middle one."
msgstr ""

#: includes/settings-fields.php:1151
msgid "Neighbour offset (%)"
msgstr ""

#: includes/settings-fields.php:1157
msgid "How far each neighbour sits from the one before it, in % of the middle slide’s width: below 100 they overlap."
msgstr ""

#: includes/settings-fields.php:1162
msgid "Neighbour scale"
msgstr ""

#: includes/settings-fields.php:1168
msgid "Size of the first neighbour; each further one shrinks as much again."
msgstr ""

#: includes/settings-fields.php:1173
msgid "Neighbour opacity (%)"
msgstr ""

#: includes/settings-fields.php:1179
msgid "Of the first neighbour; each further one fades as much again."
msgstr ""

#: includes/settings-fields.php:1187
msgid "Effect shadows"
msgstr ""

#: includes/settings-fields.php:1190
msgid "Shades the slides as they turn. Not with Image fit “Contain”."
msgstr ""

#: includes/settings-fields.php:1197
msgid "Rotate (°)"
msgstr ""

#: includes/settings-fields.php:1204
msgid "How far the side slides turn: above 0 towards the middle one, below 0 away from it (outwards)."
msgstr ""

#: includes/settings-fields.php:1213
msgid "Depth (px)"
msgstr ""

#: includes/settings-fields.php:1220
msgid "How far back the side slides sit: the more, the smaller they look."
msgstr ""

#: includes/settings-fields.php:1225
msgid "Stretch (px)"
msgstr ""

#: includes/settings-fields.php:1232
msgid "Above 0 the side slides move in under the active one; below 0 they move apart."
msgstr ""

#: includes/settings-fields.php:1237
msgid "Side slides scale"
msgstr ""

#: includes/settings-fields.php:1243
msgid "1 = the size of the active slide; 0.8 = smaller."
msgstr ""

#: includes/settings-fields.php:1253
msgid "Shadow under the cube"
msgstr ""

#: includes/settings-fields.php:1261
msgid "Offset (px)"
msgstr ""

#: includes/settings-fields.php:1267
msgid "How far below the cube the shadow falls."
msgstr ""

#: includes/settings-fields.php:1273
msgid "Scale"
msgstr ""

#: includes/settings-fields.php:1279
msgid "Size of the shadow: 1 = as wide as the cube."
msgstr ""

#: includes/settings-fields.php:1293
msgid "Darken side faces"
msgstr ""

#: includes/settings-fields.php:1296
msgid "Shades the faces as they turn away. Not with Image fit “Contain”."
msgstr ""

#: includes/settings-fields.php:1305
msgid "Stack offset (%)"
msgstr ""

#: includes/settings-fields.php:1311
msgid "How far each card of the stack peeks out from under the one above it, in % of the card width. Three cards show on each side; what reaches past the block is cut off."
msgstr ""

#: includes/settings-fields.php:1318
msgid "Rotate cards"
msgstr ""

#: includes/settings-fields.php:1321
msgid "Tilts the cards of the stack and, while it moves, the card being turned."
msgstr ""

#: includes/settings-fields.php:1326
msgid "Stack rotation (°)"
msgstr ""

#: includes/settings-fields.php:1332
msgid "Tilt of each card of the stack. 0 = straight."
msgstr ""

#: includes/settings-fields.php:1343
msgid "Thumbnails position"
msgstr ""

#: includes/settings-fields.php:1348
msgid "Below the slider"
msgstr ""

#: includes/settings-fields.php:1349
msgid "Above the slider"
msgstr ""

#: includes/settings-fields.php:1350
msgid "Left of the slider"
msgstr ""

#: includes/settings-fields.php:1351
msgid "Right of the slider"
msgstr ""

#: includes/settings-fields.php:1353
msgid "Left or right: a column as tall as the slider; its width follows from the thumbnail size."
msgstr ""

#: includes/settings-fields.php:1359
msgid "Thumbnails alignment"
msgstr ""

#: includes/settings-fields.php:1364
msgid "Start (left; top in a column)"
