msgid "CSS class"
msgstr ""

#: includes/settings-fields.php:1728
msgid "One or more, separated by spaces. Added to the slider’s outer block, with those given where it is placed."
msgstr ""

#: includes/settings-fields.php:1733
msgid "ID"
msgstr ""

#: includes/settings-fields.php:1737
msgid "The id of the slider’s outer block: letters, digits, - and _. An id must be unique on a page, so do not place this slider twice on one page."
