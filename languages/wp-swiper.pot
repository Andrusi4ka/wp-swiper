msgstr ""

#: includes/settings-fields.php:1688
msgid "Play, sound and progress. Always on without Play automatically: the visitor starts the video."
msgstr ""

#: includes/settings-fields.php:1693
msgid "Pause when the slide is left"
msgstr ""

#: includes/settings-fields.php:1696
msgid "Off: it plays on unseen (sound too) and carries on from there when its slide is back."
msgstr ""

#: includes/settings-fields.php:1701
msgid "Next slide when the video ends"
